# ============================================
# Notebook 22 — Publication Figure Pack
# Fully Locked Template (No Format Drift)
# ============================================

import os, json, shutil, zipfile
import numpy as np
import matplotlib.pyplot as plt

# --------------------------------------------
# 1. Setup
# --------------------------------------------

NOTEBOOK_ID = "22_publication_figure_pack"

BASE_DIR = os.getcwd()
EXPORT_DIR = os.path.join(BASE_DIR, "exports", NOTEBOOK_ID)
FIG_DIR = os.path.join(EXPORT_DIR, "figures")
LATEX_DIR = os.path.join(EXPORT_DIR, "latex")

os.makedirs(FIG_DIR, exist_ok=True)
os.makedirs(LATEX_DIR, exist_ok=True)

MANIFEST_PATH = os.path.join(EXPORT_DIR, "manifest.json")
ZIP_PATH = os.path.join(BASE_DIR, "exports", f"{NOTEBOOK_ID}.zip")

# --------------------------------------------
# 2. Load Results (from Notebook 21)
# --------------------------------------------

INPUT_RESULTS = os.path.join(BASE_DIR, "exports", "21_statistical_validation", "results.json")

with open(INPUT_RESULTS, "r") as f:
    results = json.load(f)

# --------------------------------------------
# 3. Figure Style (Publication Standard)
# --------------------------------------------

plt.rcParams.update({
    "font.size": 11,
    "axes.titlesize": 13,
    "axes.labelsize": 11,
    "legend.fontsize": 10,
    "figure.dpi": 150,
    "savefig.dpi": 300
})

def save_fig(fig, name):
    png_path = os.path.join(FIG_DIR, f"{name}.png")
    pdf_path = os.path.join(FIG_DIR, f"{name}.pdf")
    fig.savefig(png_path, bbox_inches="tight")
    fig.savefig(pdf_path, bbox_inches="tight")
    plt.close(fig)
    return png_path, pdf_path

# --------------------------------------------
# 4. Figure Exports
# --------------------------------------------

figure_registry = []

def register_figure(name, caption):
    figure_registry.append({
        "name": name,
        "caption": caption,
        "png": f"figures/{name}.png",
        "pdf": f"figures/{name}.pdf"
    })

# ---- Figure 1: Singular Spectrum ----
fig, ax = plt.subplots()

x = np.arange(len(results["real"]["singular_values"]))
ax.plot(x, results["real"]["singular_values"], label="real")

for k in ["iid_shuffle", "markov_synthetic"]:
    ax.plot(x, results[k]["singular_values"], linestyle="--", label=k)

ax.set_title("Singular spectrum: real vs controls")
ax.set_xlabel("rank")
ax.set_ylabel("singular value")
ax.legend()

save_fig(fig, "fig1_singular_spectrum")

register_figure(
    "fig1_singular_spectrum",
    "Singular value spectrum comparing real sequence to null controls."
)

# ---- Figure 2: MI Excess ----
fig, ax = plt.subplots()

labels = list(results.keys())
values = [results[k]["mi_excess"] for k in labels]

ax.bar(labels, values)
ax.set_title("Mutual information excess over nulls")
ax.set_ylabel("bits")

save_fig(fig, "fig2_mi_excess")

register_figure(
    "fig2_mi_excess",
    "Mutual information excess relative to shuffled baselines."
)

# ---- Figure 3: L2 Residual ----
fig, ax = plt.subplots()

vals = [results[k]["l2_residual"] for k in labels]

ax.bar(labels, vals)
ax.set_title("Two-step operator residual (L2)")
ax.set_ylabel("Frobenius norm")

save_fig(fig, "fig3_l2_residual")

register_figure(
    "fig3_l2_residual",
    "Two-step operator residual magnitude across control conditions."
)

# ---- Figure 4: Rank Requirement ----
fig, ax = plt.subplots()

r90 = [results[k]["rank90"] for k in labels]
r95 = [results[k]["rank95"] for k in labels]

x = np.arange(len(labels))
ax.bar(x - 0.2, r90, width=0.4, label="90% energy")
ax.bar(x + 0.2, r95, width=0.4, label="95% energy")

ax.set_xticks(x)
ax.set_xticklabels(labels)
ax.set_title("Rank requirement stability")
ax.legend()

save_fig(fig, "fig4_rank_requirement")

register_figure(
    "fig4_rank_requirement",
    "Rank required to capture 90% and 95% spectral energy."
)

# ---- Figure 5: Validation Heatmap ----
fig, ax = plt.subplots()

matrix = np.array(results["validation_matrix"])

im = ax.imshow(matrix)
plt.colorbar(im)

ax.set_title("Validation summary heatmap")

save_fig(fig, "fig5_validation_heatmap")

register_figure(
    "fig5_validation_heatmap",
    "Heatmap summarizing metric ratios relative to null baselines."
)

# --------------------------------------------
# 5. Caption Generator (LaTeX)
# --------------------------------------------

def latex_figure_block(fig):
    return f"""
\\begin{{figure}}[ht]
\\centering
\\includegraphics[width=0.8\\linewidth]{{{fig["png"]}}}
\\caption{{{fig["caption"]}}}
\\end{{figure}}
"""

latex_blocks = [latex_figure_block(f) for f in figure_registry]

FIGURES_TEX = os.path.join(LATEX_DIR, "figures.tex")

with open(FIGURES_TEX, "w") as f:
    f.write("\n".join(latex_blocks))

# --------------------------------------------
# 6. Manifest
# --------------------------------------------

manifest = {
    "notebook": NOTEBOOK_ID,
    "figures": figure_registry,
    "latex_file": "latex/figures.tex",
    "input_source": INPUT_RESULTS
}

with open(MANIFEST_PATH, "w") as f:
    json.dump(manifest, f, indent=2)

# --------------------------------------------
# 7. Zip Export
# --------------------------------------------

if os.path.exists(ZIP_PATH):
    os.remove(ZIP_PATH)

with zipfile.ZipFile(ZIP_PATH, "w") as z:
    for root, _, files in os.walk(EXPORT_DIR):
        for file in files:
            full = os.path.join(root, file)
            rel = os.path.relpath(full, EXPORT_DIR)
            z.write(full, rel)

# --------------------------------------------
# 8. Determinism Check
# --------------------------------------------

print("Figures exported:", len(figure_registry))
print("Manifest written:", MANIFEST_PATH)
print("Zip ready:", ZIP_PATH)
